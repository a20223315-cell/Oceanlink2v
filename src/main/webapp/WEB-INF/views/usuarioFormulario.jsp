<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %><div class="back-row"><a class="secondary-button" href="UsuarioServlet"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Volver a usuarios</a></div><div class="page-heading"><h1>${soloLectura ? 'Detalle' : registro.id > 0 ? 'Editar' : 'Registrar'} usuario</h1><p><c:choose><c:when test="${registro.id > 0}"><c:out value="${registro.codigo}"/></c:when><c:otherwise>Complete la información del registro.</c:otherwise></c:choose></p></div><c:if test="${not empty error}"><p class="crud-message crud-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><c:out value="${error}"/></p></c:if><c:if test="${param.ok == '1'}"><p class="crud-message crud-success" role="status">Operación realizada correctamente.</p></c:if><article class="panel"><div class="panel-heading"><div><h2>Datos de usuario</h2><p>Complete la información principal.</p></div></div><div class="crud-form-body"><p class="user-form-intro">${registro.id > 0 ? 'Actualice únicamente la información que necesite modificar.' : 'Registre los datos de acceso y asigne el rol correspondiente.'}</p><c:if test="${soloLectura}"><div class="role-capabilities"><div class="role-capabilities-heading"><i class="fa-solid fa-shield-halved"></i><div><strong>Funciones habilitadas</strong><small>Según el rol asignado</small></div></div><div class="role-capability-list" data-capabilities="<c:out value='${registro.rolNombre}'/>"></div></div><div class="profile-data"><i class="fa-solid fa-right-to-bracket"></i><span><small>ÚLTIMO ACCESO</small><strong><c:out value="${registro.ultimoAccesoTexto}"/></strong></span></div></c:if><form method="post" action="UsuarioServlet" class="crud-form" data-confirm="¿Guardar los datos de este registro?" id="registro-form"><input type="hidden" name="action" value="${registro.id > 0 ? 'actualizar' : 'crear'}"><input type="hidden" name="id" value="${registro.id}"><fieldset class="crud-fields" ${soloLectura ? 'disabled' : ''}><div class="form-field"><label for="apellidos">Apellidos</label><input id="apellidos" name="apellidos" maxlength="100" required autocomplete="family-name" value="<c:out value='${param.apellidos != null ? param.apellidos : registro.apellidos}'/>"></div><div class="form-field"><label for="nombres">Nombres</label><input id="nombres" name="nombres" maxlength="57" required autocomplete="given-name" value="<c:out value='${param.nombres != null ? param.nombres : registro.nombres}'/>"></div><div class="form-field"><label for="correo">Correo</label><div class="user-email-field"><input id="correo" type="text" readonly aria-readonly="true" placeholder=" " aria-describedby="correo-indicacion" value="<c:out value='${fn:substringBefore(registro.correo, "@")}'/>"><span data-email-domain>@oceanlink.pe</span><span id="correo-indicacion" data-correo-ayuda aria-live="polite">Se genera automáticamente al ingresar nombres y apellidos</span></div></div><div class="form-field"><label for="paisId">País</label><select id="paisId" name="paisId" required><option value="" disabled ${empty param.paisId && registro.paisId == 0 ? 'selected' : ''}>Seleccione</option><c:forEach var="opcion" items="${paises}"><option value="${opcion.id}" ${(param.paisId != null ? param.paisId : registro.paisId) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></div><div class="form-field"><label for="telefono">Celular</label><div class="phone-field"><select name="telefonoRegion" class="phone-region" aria-label="País del celular" required><option value="">Prefijo</option><c:forEach var="pt" items="${paisesTelefono}"><option value="${pt.codigo()}" data-country="${pt.codigo()}" data-prefix="${pt.prefijo()}" ${param.telefonoRegion != null ? (param.telefonoRegion == pt.codigo() ? 'selected' : '') : (registro.telefonoRegion == pt.codigo() ? 'selected' : '')}><c:out value="${pt.nombre()}"/> (${pt.prefijo()})</option></c:forEach></select><input id="telefono" name="telefono" type="tel" required maxlength="30" value="<c:out value='${param.telefono != null ? param.telefono : registro.telefonoLocal}'/>"></div></div><div class="form-field"><label for="fechaIngreso">Fecha de ingreso</label><c:choose><c:when test="${registro.id > 0}"><input readonly id="fechaIngreso" aria-readonly="true" value="${fechaIngresoTexto}"></c:when><c:otherwise><input id="fechaIngreso" name="fechaIngreso" type="date" required max="${hoy}" value="<c:out value='${param.fechaIngreso != null ? param.fechaIngreso : fn:substring(registro.fechaIngreso,0,10)}'/>"></c:otherwise></c:choose></div><c:if test="${registro.id == 0}"><div class="form-field crud-wide"><label for="contrasenaTemporal">Contraseña temporal</label><input id="contrasenaTemporal" name="contrasenaTemporal" type="password" minlength="8" maxlength="100" required autocomplete="new-password" placeholder="Mínimo 8 caracteres"><small>El administrador asigna esta contraseña. Se guardará como hash SHA-256.</small></div></c:if><div class="user-create-role-row crud-wide"><div class="form-field"><label for="rolId">Rol</label><select id="rolId" name="rolId" required><option value="" disabled ${empty param.rolId && registro.rolId == 0 ? 'selected' : ''}>Seleccione</option><c:forEach var="opcion" items="${roles}"><option value="${opcion.id}" ${(param.rolId != null ? param.rolId : registro.rolId) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></div><c:if test="${registro.id == 0}"><div class="user-pending-note"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><div><small>ESTADO INICIAL</small><strong>Cuenta activa al guardar</strong><p>La contraseña temporal permitirá al usuario iniciar sesión con el correo corporativo generado.</p></div></div></c:if><c:if test="${registro.id > 0}"><div class="form-field"><label for="estadoUsuario">Estado</label><input id="estadoUsuario" readonly value="<c:out value='${registro.estadoTexto}'/>"></div></c:if></div></fieldset><c:if test="${!soloLectura}"><section class="role-capabilities form-permissions" data-form-permissions hidden aria-label="Permisos del rol"><div class="role-capabilities-heading"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i><div><strong>Permisos / funcionalidades habilitadas</strong><small>Se asignan automáticamente según el rol seleccionado.</small></div></div><div class="role-capability-list" data-role-permissions aria-live="polite"></div></section></c:if><c:if test="${!soloLectura}"><div class="form-actions"><a class="danger-button" href="UsuarioServlet">Cancelar</a><button type="submit" class="primary-button"><i class="fa-solid fa-check" aria-hidden="true"></i><span>${registro.id > 0 ? 'Guardar cambios' : 'Guardar usuario'}</span></button></div></c:if></form></div></article><%@ include file="pie.jspf" %>
