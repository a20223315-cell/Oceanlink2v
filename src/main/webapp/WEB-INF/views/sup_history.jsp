<%@ page pageEncoding="UTF-8" %>
<% request.setAttribute("clasePagina","supervisor-view"); %><%@ include file="cabecera.jspf" %>
<div class="page-heading"><h1>Indicadores históricos</h1><p>Evolución temporal de utilización, incidencias y mantenimientos.</p></div>
<div aria-label="Tipo de histórico" class="history-tabs" role="tablist"><button aria-selected="true" class="history-tab active" data-history-tab="utilizacion" role="tab" type="button">Utilización</button><button aria-selected="false" class="history-tab" data-history-tab="incidencias" role="tab" type="button">Incidencias</button><button aria-selected="false" class="history-tab" data-history-tab="mantenimientos" role="tab" type="button">Mantenimientos</button></div>
<div class="filter-panel history-global-filters"><div class="filter-grid"><div class="filter-field"><label for="ol-control-0">Segmento</label><select name="segmento" class="history-segment-select" id="ol-control-0"><option value="Toda la red" selected="">Toda la red</option><c:forEach var="opcion" items="${alcances}"><option value="${opcion[0]}"><c:out value="${opcion[1]}"/></option></c:forEach></select></div><div class="filter-field"><label for="ol-control-1">Fecha desde</label><input class="history-date-start" type="date" value="2026-08-20" id="ol-control-1"></div><div class="filter-field"><label for="ol-control-2">Fecha hasta</label><input class="history-date-end" type="date" value="2026-09-30" id="ol-control-2"></div><div class="filter-actions"><button class="primary-button history-filter-submit" type="button"><i class="fa-solid fa-filter"></i> Filtrar</button></div></div></div>
<article class="panel history-tab-panel active" data-history-panel="utilizacion"><div class="panel-heading history-heading"><div><h2>Utilización de toda la red</h2><p>Historial registrado en la base de datos</p></div></div><div class="history-kpis"><div class="history-kpi"><span>Promedio</span><strong data-history-metric>—</strong></div><div class="history-kpi"><span>Máximo</span><strong data-history-metric>—</strong></div><div class="history-kpi"><span>Tendencia</span><strong data-history-metric>—</strong></div></div><div aria-label="Evolución de la utilización" class="history-line-chart"><c:forEach var="punto" items="${serie}"><span data-chart-date="${punto[0]}" data-chart-value="${punto[1]}" data-chart-segment="${punto[2]}"></span></c:forEach></div></article>
<article class="panel history-tab-panel" data-history-panel="incidencias">
<div class="panel-heading"><div><h2>Historial de incidencias</h2><p data-history-inc-period>Historial registrado en la base de datos</p></div><a class="secondary-button" href="sup_incidents.html">Ver detalle</a></div>
<div class="history-kpis history-kpis--four" aria-label="Resumen histórico de incidencias">
<div class="history-kpi"><span>Registradas</span><strong><c:out value="${histInc[0]}"/></strong></div>
<div class="history-kpi"><span>Cerradas</span><strong><c:out value="${histInc[1]}"/></strong></div>
<div class="history-kpi"><span>Críticas</span><strong><c:out value="${histInc[2]}"/></strong></div>
<div class="history-kpi"><span>Servicios afectados</span><strong><c:out value="${histInc[3]}"/></strong></div>
</div>
<div class="history-visual-grid"><section class="history-visual-card"><div class="history-visual-heading"><strong>Incidencias por semana y severidad</strong><span>Volumen del periodo</span></div><c:forEach var="evento" items="${eventosInc}"><span hidden data-event-date="${evento[0]}" data-event-type="${evento[1]}" data-event-status="${evento[2]}" data-event-segment="${evento[3]}" data-event-services="${evento[5]}"></span></c:forEach><div class="history-stat-chart" data-history-incidents-chart role="img" aria-label="Incidencias por semana y severidad"></div></section><section class="history-visual-card"><div class="history-visual-heading"><strong>Distribución por estado</strong><span>Situación al cierre</span></div><div class="history-distribution" data-history-incidents-status></div></section></div>
<div class="history-list-heading"><strong>Incidencias cerradas</strong><span>Trazabilidad del periodo</span></div>
<div class="table-container"><table data-client-page class=""><thead><tr><th>Código</th><th>Segmento</th><th>Severidad</th><th>Cierre</th><th>Resultado</th><th>Acción</th></tr></thead><tbody><c:forEach var="fila" items="${tablas[0]}"><tr><c:forEach var="celda" items="${fila}" varStatus="col"><td><c:choose><c:when test="${fn:startsWith(celda,'LINK:')}"><a class="icon-action" title="Ver detalle" aria-label="Ver detalle" href="${fn:substringAfter(celda,'LINK:')}"><i class="fa-regular fa-eye"></i></a></c:when><c:otherwise><c:out value="${celda}"/></c:otherwise></c:choose></td></c:forEach></tr></c:forEach></tbody></table></div>
</article>
<article class="panel history-tab-panel" data-history-panel="mantenimientos" id="mantenimientos">
<div class="panel-heading"><div><h2>Historial de mantenimientos</h2><p data-history-mnt-period>Historial registrado en la base de datos</p></div><a class="secondary-button" href="sup_maintenance.html">Ver detalle</a></div>
<div class="history-kpis history-kpis--four" aria-label="Resumen histórico de mantenimientos">
<div class="history-kpi"><span>Intervenciones</span><strong><c:out value="${histMant[0]}"/></strong></div>
<div class="history-kpi"><span>Finalizadas</span><strong><c:out value="${histMant[1]}"/></strong></div>
<div class="history-kpi"><span>Programadas</span><strong><c:out value="${histMant[2]}"/></strong></div>
<div class="history-kpi"><span>Servicios involucrados</span><strong><c:out value="${histMant[3]}"/></strong></div>
</div>
<div class="history-visual-grid"><section class="history-visual-card"><div class="history-visual-heading"><strong>Mantenimientos por semana y tipo</strong><span>Actividad del periodo</span></div><c:forEach var="evento" items="${eventosMant}"><span hidden data-event-date="${evento[0]}" data-event-type="${evento[1]}" data-event-status="${evento[2]}" data-event-segment="${evento[3]}" data-event-services="${evento[5]}"></span></c:forEach><div class="history-stat-chart" data-history-maintenance-chart role="img" aria-label="Mantenimientos por semana y tipo"></div></section><section class="history-visual-card"><div class="history-visual-heading"><strong>Distribución por estado</strong><span>Situación al cierre</span></div><div class="history-distribution" data-history-maintenance-status></div></section></div>
<div class="history-list-heading"><strong>Mantenimientos finalizados</strong><span>Resultados del periodo</span></div>
<div class="table-container"><table data-client-page class=""><thead><tr><th>Código</th><th>Tipo</th><th>Infraestructura</th><th>Fecha de cierre</th><th>Resultado</th><th>Acción</th></tr></thead><tbody><c:forEach var="fila" items="${tablas[1]}"><tr><c:forEach var="celda" items="${fila}" varStatus="col"><td><c:choose><c:when test="${fn:startsWith(celda,'LINK:')}"><a class="icon-action" title="Ver detalle" aria-label="Ver detalle" href="${fn:substringAfter(celda,'LINK:')}"><i class="fa-regular fa-eye"></i></a></c:when><c:otherwise><c:out value="${celda}"/></c:otherwise></c:choose></td></c:forEach></tr></c:forEach></tbody></table></div>
</article>
<%@ include file="pie.jspf" %>
