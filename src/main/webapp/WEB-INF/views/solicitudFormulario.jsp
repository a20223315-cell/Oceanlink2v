<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %><div class="back-row"><a class="secondary-button" href="SolicitudServlet"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Volver a solicitudes de capacidad</a></div><div class="page-heading"><h1>${soloLectura ? 'Detalle' : registro.id > 0 ? 'Editar' : 'Registrar'} solicitud</h1><p><c:choose><c:when test="${registro.id > 0}"><c:out value="${registro.codigo}"/></c:when><c:otherwise>Complete la información del registro.</c:otherwise></c:choose></p></div><c:if test="${not empty error}"><p class="crud-message crud-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><c:out value="${error}"/></p></c:if><c:if test="${param.ok == '1'}"><p class="crud-message crud-success" role="status">Operación realizada correctamente.</p></c:if><article class="panel"><div class="panel-heading"><div><h2>Datos de solicitud</h2><p>Complete la información principal.</p></div></div><div class="crud-form-body"><form method="post" action="SolicitudServlet" class="crud-form" data-workflow="solicitud" data-current-state="${registro.estado}" id="registro-form"><input type="hidden" name="action" value="${registro.id > 0 ? 'actualizar' : 'crear'}"><input type="hidden" name="id" value="${registro.id}"><fieldset class="crud-fields" ${soloLectura ? 'disabled' : ''}><div class="form-field"><label for="clienteId">Cliente</label><select id="clienteId" name="clienteId" required><option value="" disabled ${empty param.clienteId && registro.clienteId == 0 ? 'selected' : ''}>Seleccione</option><c:forEach var="opcion" items="${clientes}"><option value="${opcion.id}" ${(param.clienteId != null ? param.clienteId : registro.clienteId) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></div><div class="form-field"><label for="origenId">Estación de origen</label><select id="origenId" name="origenId" required><option value="" disabled ${empty param.origenId && registro.origenId == 0 ? 'selected' : ''}>Seleccione</option><c:forEach var="opcion" items="${estaciones}"><option value="${opcion.id}" ${(param.origenId != null ? param.origenId : registro.origenId) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></div><div class="form-field"><label for="destinoId">Estación de destino</label><select id="destinoId" name="destinoId" required><option value="" disabled ${empty param.destinoId && registro.destinoId == 0 ? 'selected' : ''}>Seleccione</option><c:forEach var="opcion" items="${estaciones}"><option value="${opcion.id}" ${(param.destinoId != null ? param.destinoId : registro.destinoId) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></div><div class="form-field"><label for="capacidad">Capacidad solicitada (Tbps)</label><input id="capacidad" name="capacidad" type="number" maxlength="30" required step="0.0001" min="0.0001" value="<c:out value='${param.capacidad != null ? param.capacidad : registro.capacidad}'/>"></div><div class="form-field crud-wide"><label for="ruta">Ruta asignada</label><select name="ruta" id="ruta" required><option value="">Seleccione origen y destino</option><c:forEach var="ruta" items="${rutas}"><option value="${ruta.key}" ${(param.ruta != null ? param.ruta : registro.ruta) == ruta.key ? 'selected' : ''}><c:out value="${ruta.value}"/></option></c:forEach></select><small data-route-status aria-live="polite">Seleccione la ruta que conecta las estaciones.</small></div><div class="form-field"><label for="estado">Estado</label><select id="estado" name="estado" required><option value="" disabled>Seleccione</option><option value="REGISTRADA" ${fn:contains(permitidos,'REGISTRADA') ? '' : 'disabled'} ${(param.estado != null ? param.estado : registro.estado) == 'REGISTRADA' ? 'selected' : ''}>Registrada</option><option value="EN_EVALUACION" ${fn:contains(permitidos,'EN_EVALUACION') ? '' : 'disabled'} ${(param.estado != null ? param.estado : registro.estado) == 'EN_EVALUACION' ? 'selected' : ''}>En evaluación</option><option value="APROBADA" ${fn:contains(permitidos,'APROBADA') ? '' : 'disabled'} ${(param.estado != null ? param.estado : registro.estado) == 'APROBADA' ? 'selected' : ''}>Aprobada</option><option value="PROVISIONADA" ${fn:contains(permitidos,'PROVISIONADA') ? '' : 'disabled'} ${(param.estado != null ? param.estado : registro.estado) == 'PROVISIONADA' ? 'selected' : ''}>Provisionada</option><option value="ACTIVA" ${fn:contains(permitidos,'ACTIVA') ? '' : 'disabled'} ${(param.estado != null ? param.estado : registro.estado) == 'ACTIVA' ? 'selected' : ''}>Activa</option><option value="RECHAZADA" ${fn:contains(permitidos,'RECHAZADA') ? '' : 'disabled'} ${(param.estado != null ? param.estado : registro.estado) == 'RECHAZADA' ? 'selected' : ''}>Rechazada</option><option value="PENDIENTE_CAPACIDAD" ${fn:contains(permitidos,'PENDIENTE_CAPACIDAD') ? '' : 'disabled'} ${(param.estado != null ? param.estado : registro.estado) == 'PENDIENTE_CAPACIDAD' ? 'selected' : ''}>Pendiente por capacidad</option></select></div><div class="form-field"><label for="creadoPor">Registrado por</label><select id="creadoPor" name="creadoPor" required><option value="" disabled>Seleccione</option><c:forEach var="opcion" items="${usuarios}"><option value="${opcion.id}" ${(param.creadoPor != null ? param.creadoPor : registro.creadoPor) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></div><div class="form-field"><label for="observacion">Observación</label><textarea id="observacion" name="observacion" rows="3" maxlength="2000"><c:out value="${param.observacion != null ? param.observacion : registro.observacion}"/></textarea></div></fieldset><c:if test="${!soloLectura}"><div class="form-actions"><a class="danger-button" href="SolicitudServlet">Cancelar</a><button type="submit" class="primary-button"><i class="fa-solid fa-check" aria-hidden="true"></i>Guardar solicitud</button></div></c:if></form></div></article><%@ include file="solicitudFlujo.jspf" %><%@ include file="pie.jspf" %>
