<%@ page pageEncoding="UTF-8" %><%@ include file="cabecera.jspf" %>
<div class="back-row"><a class="secondary-button" href="ConsultaServlet?vista=${menu == 'no' ? 'red' : 'capacidad'}${menu == 'sup' ? '&amp;menu=sup' : ''}">← Volver a la consulta</a></div><div class="page-heading"><h1><c:out value="${titulo}"/> · <c:out value="${registro.codigo}"/></h1><p><c:out value="${registro.origenNombre}"/> — <c:out value="${registro.destinoNombre}"/></p></div>
<article class="panel"><div class="panel-heading"><h2>Información del segmento</h2><span class="status"><c:out value="${etiquetas[registro.condicion]}"/></span></div><div class="detail-grid"><div class="detail-item"><strong>Capacidad total</strong><span>${registro.capacidad.stripTrailingZeros().toPlainString()} Tbps</span></div><div class="detail-item"><strong>Utilizada</strong><span>${usada} Tbps</span></div><div class="detail-item"><strong>Reservada</strong><span>${reservada} Tbps</span></div><div class="detail-item"><strong>Disponible</strong><span>${disponible} Tbps</span></div><div class="detail-item"><strong>Utilización</strong><span>${porcentaje}%</span></div></div></article>
<article class="panel crud-related"><div class="panel-heading"><h2>Servicios y clientes que utilizan el segmento</h2></div><div class="table-container"><table data-client-page><thead><tr><th>Servicio</th><th>Cliente</th><th>Capacidad (Tbps)</th><th>Estado</th></tr></thead><tbody><c:forEach var="fila" items="${servicios}"><tr><c:forEach var="celda" items="${fila}"><td><c:out value="${celda}"/></td></c:forEach></tr></c:forEach></tbody></table></div></article>
<article class="panel crud-related"><div class="panel-heading"><h2>Historial de capacidad</h2></div><div class="table-container"><table data-client-page><thead><tr><th>Fecha</th><th>Total (Tbps)</th><th>Utilizada (Tbps)</th><th>Reservada (Tbps)</th></tr></thead><tbody><c:forEach var="fila" items="${historial}"><tr><c:forEach var="celda" items="${fila}"><td><c:out value="${celda}"/></td></c:forEach></tr></c:forEach></tbody></table></div></article><%@ include file="pie.jspf" %>
