<%@ page pageEncoding="UTF-8" %>
<c:if test="${registro.id > 0}"><div class="request-stepper" aria-label="Flujo principal de la solicitud"><c:forEach var="paso" items="${pasosSolicitud}"><div class="request-step ${registro.estado == paso ? 'active' : ''}"><span class="request-step-dot"><i class="fa-solid fa-check" aria-hidden="true"></i></span><strong><c:out value="${etiquetas[paso]}"/></strong></div></c:forEach></div><article class="panel crud-related"><div class="panel-heading"><div><h2>Evaluación de ruta y capacidad</h2><p>Capacidad requerida: ${registro.capacidad.stripTrailingZeros().toPlainString()} Tbps · Límite de la ruta: <c:out value="${limiteRuta}"/></p></div><span class="status ${viabilidadOk ? 'ok' : 'danger'}">${registro.estado == 'ACTIVA' ? 'Servicio activado' : registro.estado == 'PROVISIONADA' ? 'Reserva confirmada' : viabilidadOk ? 'Ruta viable' : 'Revisar capacidad y estado de la ruta'}</span></div><div class="table-container"><table data-client-page><thead><tr><th>Orden</th><th>Segmento</th><th>Ruta</th><th>Disponible (Tbps)</th><th>Estado</th></tr></thead><tbody><c:forEach var="fila" items="${rutaEvaluada}"><tr><c:forEach var="celda" items="${fila}"><td><c:out value="${celda}"/></td></c:forEach></tr></c:forEach></tbody></table></div></article></c:if>
