<%@ page pageEncoding="UTF-8" %>
<% request.setAttribute("clasePagina", "supervisor-view"); %><%@ include file="cabecera.jspf" %>
<div class="page-heading"><h1>Panel de indicadores</h1><p>Estado consolidado de capacidad, incidencias, servicios y mantenimiento.</p></div>
<div class="supervisor-toolbar panel"><div class="supervisor-toolbar-copy"><span class="section-kicker">RESUMEN EJECUTIVO</span><strong>Estado global de la red</strong><p>Capacidad, incidencias, servicios y mantenimiento en una sola vista.</p></div><form method="get" class="supervisor-toolbar-filters"><input type="hidden" name="vista" value="general"><input type="hidden" name="menu" value="sup"><div><span>Periodo</span><select name="periodo" aria-label="Periodo del panel"><c:forEach var="dias" items="${[7,30,90]}"><option value="${dias}" ${periodo == dias ? 'selected' : ''}>Últimos ${dias} días</option></c:forEach></select></div><div><span>Alcance</span><select name="segmento" aria-label="Alcance del panel"><option value="">Toda la red</option><c:forEach var="opcion" items="${alcances}"><option value="${opcion[0]}" ${param.segmento == opcion[0] ? 'selected' : ''}><c:out value="${opcion[1]}"/></option></c:forEach></select></div><button class="primary-button" type="submit">Aplicar</button></form></div>
<div class="cards supervisor-kpis">
<article class="summary-card"><div class="metric-icon info"><i class="fa-solid fa-percent"></i></div><span class="metric-label">Utilización promedio</span><strong><c:out value="${kpis[0]}"/></strong><small>Estado actual · promedio por segmento</small></article>
<article class="summary-card"><div class="metric-icon danger"><i class="fa-solid fa-triangle-exclamation"></i></div><span class="metric-label">Incidencias activas</span><strong><c:out value="${kpis[1]}"/></strong><small>Eventos del periodo seleccionado</small></article>
<article class="summary-card"><div class="metric-icon warning"><i class="fa-solid fa-building-user"></i></div><span class="metric-label">Servicios afectados</span><strong><c:out value="${kpis[2]}"/></strong><small>Servicios únicos afectados</small></article>
<article class="summary-card"><div class="metric-icon info"><i class="fa-solid fa-screwdriver-wrench"></i></div><span class="metric-label">Mantenimientos</span><strong><c:out value="${kpis[3]}"/></strong><small>Programados y en ejecución</small></article>
</div>
<div class="supervisor-priority-grid">
<article class="panel supervisor-priority-card"><div class="panel-heading"><div><span class="section-kicker">ATENCIÓN PRIORITARIA</span><h2>Segmentos con mayor utilización</h2><p>Vista resumida de los tramos que requieren seguimiento.</p></div><a class="secondary-button" href="ConsultaServlet?vista=capacidad&amp;menu=sup">Ver todos</a></div>

<c:forEach var="fila" items="${prioridad}"><div class="priority-segment"><div><strong><c:out value="${fila[0]}"/></strong><span><c:out value="${fila[1]}"/></span></div><div class="priority-meter"><span class="${fila[3]}" style="width:${fila[2]}%"></span></div><b><c:out value="${fila[2]}"/>%</b><span class="status ${fila[4]}"><c:out value="${fila[5]}"/></span></div></c:forEach></article>
<article class="panel supervisor-alert-card alerts-danger"><div class="panel-heading"><div><span class="section-kicker">SEGUIMIENTO</span><h2>Alertas recientes</h2><p>Situaciones que conviene revisar primero.</p></div></div><div class="alert-feed"><c:forEach var="fila" items="${alertas}"><a href="IncidenciaServlet?action=detalle&amp;id=${fila[0]}"><i class="fa-solid fa-triangle-exclamation"></i><span><strong><c:out value="${fila[1]}"/> · <c:out value="${etiquetas[fila[2]]}"/></strong><small><c:out value="${etiquetas[fila[3]]}"/></small></span></a></c:forEach><c:if test="${empty alertas}"><p>No hay incidencias en el periodo seleccionado.</p></c:if></div></article>
</div>

<%@ include file="pie.jspf" %>
