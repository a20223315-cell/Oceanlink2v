<%@ page pageEncoding="UTF-8" %><%@ include file="cabecera.jspf" %>
<div class="back-row"><a class="secondary-button" href="ConsultaServlet?vista=reportes&amp;menu=sup">Volver a reportes</a></div>
<article class="panel"><div class="panel-heading"><div><h1>Reporte operativo</h1><p><c:out value="${tipoReporte}"/> · ${desdeReporte} — ${hastaReporte}</p><p><c:choose><c:when test="${reporteAnterior}">Reporte anterior sin instantánea guardada: consulta actual de sus criterios.</c:when><c:when test="${not empty param.id}">Datos conservados al generar el reporte.</c:when><c:otherwise>Previsualización de los datos que se conservarán al generar.</c:otherwise></c:choose></p></div><button class="primary-button" type="button" data-view-pdf>Ver PDF</button></div>
<div class="table-container"><table><thead><tr><c:forEach var="col" items="${columnas}"><th><c:out value="${col}"/></th></c:forEach></tr></thead><tbody><c:forEach var="fila" items="${filas}"><tr><c:forEach var="celda" items="${fila}"><td><c:out value="${celda}"/></td></c:forEach></tr></c:forEach></tbody></table></div>
<c:if test="${empty filas}"><p>No hay registros para los criterios seleccionados.</p></c:if>
<c:if test="${empty param.id}"><form method="post" action="ReporteServlet"><input type="hidden" name="tipo" value="${tipoReporte}"><input type="hidden" name="desde" value="${desdeReporte}"><input type="hidden" name="hasta" value="${hastaReporte}"><input type="hidden" name="segmento" value="${segmentoReporte == 0 ? '' : segmentoReporte}"><button class="primary-button" type="submit">Guardar en historial</button></form></c:if></article><script defer src="${pageContext.request.contextPath}/js/reportes-pdf.js?v=20261024"></script><%@ include file="pie.jspf" %>
