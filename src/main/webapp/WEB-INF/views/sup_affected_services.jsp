<%@ page pageEncoding="UTF-8" %>
<% request.setAttribute("clasePagina","supervisor-view"); %><%@ include file="cabecera.jspf" %>
<div class="page-heading"><h1>Servicios y clientes afectados</h1><p>Consulte el impacto de las incidencias activas sobre servicios empresariales y clientes.</p></div>
<div class="cards supervisor-kpis"><article class="summary-card"><div class="metric-icon danger"><i class="fa-solid fa-link-slash"></i></div><span class="metric-label">Servicios afectados</span><strong><c:out value="${resumen[0]}"/></strong></article><article class="summary-card"><div class="metric-icon warning"><i class="fa-solid fa-building-user"></i></div><span class="metric-label">Clientes afectados</span><strong><c:out value="${resumen[1]}"/></strong></article><article class="summary-card"><div class="metric-icon info"><i class="fa-solid fa-gauge-high"></i></div><span class="metric-label">Capacidad comprometida</span><strong><c:out value="${resumen[2]}"/></strong></article><article class="summary-card"><div class="metric-icon danger"><i class="fa-solid fa-circle-exclamation"></i></div><span class="metric-label">Por incidencia crítica</span><strong><c:out value="${resumen[3]}"/></strong></article></div>
<article class="panel"><div class="panel-heading"><div><h2>Detalle de afectación</h2><p>Relación entre incidencias, segmentos, servicios y clientes afectados.</p></div></div><div class="filter-panel"><div class="filter-grid"><div class="filter-field"><label for="ol-control-0">Filtrar por incidencia</label><input placeholder="Ej. INC-005" type="search" id="ol-control-0"></div><div class="filter-field"><label for="ol-control-1">Filtrar por cliente</label><input placeholder="Ej. Telco Global" type="search" id="ol-control-1"></div><div class="filter-field"><label for="ol-control-2">Filtrar por severidad</label><select id="ol-control-2"><option selected="">Todas</option><option>Crítica</option><option>Alta</option><option>Media</option><option>Baja</option></select></div><div class="filter-actions"><button class="primary-button filter-submit" type="button"><i class="fa-solid fa-filter"></i> Filtrar</button></div></div></div><div class="table-container"><table data-client-page class=""><thead><tr><th>Incidencia</th><th>Segmento</th><th>Servicio</th><th>Cliente</th><th class="cell-center">Capacidad (Tbps)</th><th class="cell-center">Severidad</th></tr></thead><tbody><c:forEach var="fila" items="${tablas[0]}"><tr><c:forEach var="celda" items="${fila}" varStatus="col"><td><c:choose><c:when test="${fn:startsWith(celda,'LINK:')}"><a class="icon-action" title="Ver detalle" aria-label="Ver detalle" href="${fn:substringAfter(celda,'LINK:')}"><i class="fa-regular fa-eye"></i></a></c:when><c:otherwise><c:out value="${celda}"/></c:otherwise></c:choose></td></c:forEach></tr></c:forEach></tbody></table></div></article>
<%@ include file="pie.jspf" %>
