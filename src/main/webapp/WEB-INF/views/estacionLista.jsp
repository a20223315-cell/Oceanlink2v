<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %><div class="page-heading"><h1>Estaciones de aterrizaje</h1><p>Administre las estaciones de aterrizaje, su ubicación y condición operativa.</p></div><c:if test="${not empty error}"><p class="crud-message crud-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><c:out value="${error}"/></p></c:if><c:if test="${param.ok == '1'}"><p class="crud-message crud-success" role="status">Operación realizada correctamente.</p></c:if><article class="panel"><div class="panel-heading"><div><h2>Estaciones registradas</h2><p>Consulte los registros y su estado actual.</p></div><a class="primary-button" href="EstacionServlet?action=formCrear"><i class="fa-solid fa-plus" aria-hidden="true"></i>Registrar estación</a></div>
<form class="filter-panel" method="get" action="EstacionServlet"><div class="filter-grid" role="search"><div class="filter-field"><label for="q">Buscar por código o nombre</label><input id="q" name="q" type="search" maxlength="160" placeholder="Ej. PE-0001, 1 o Lurín" value="<c:out value='${q}'/>"></div><div class="filter-field"><label for="paisFiltro">Filtrar por país</label><select name="paisFiltro" id="paisFiltro"><option value="">Todos los países</option><c:forEach var="pais" items="${paises}"><option value="${pais.id}" ${paisFiltro == pais.id ? 'selected' : ''}><c:out value="${pais.nombre}"/></option></c:forEach></select></div><div class="filter-field"><label for="estadoFiltro">Filtrar por condición operativa</label><select name="estado" id="estadoFiltro"><option value="">Todos</option><c:forEach var="estado" items="${estados}"><option value="${estado}" ${estadoFiltro == estado ? 'selected' : ''}><c:out value="${etiquetas[estado]}"/></option></c:forEach></select></div><div class="filter-actions"><button type="submit" class="primary-button"><i class="fa-solid fa-filter" aria-hidden="true"></i>Filtrar</button><a class="secondary-button" href="EstacionServlet">Limpiar</a></div></div><input type="hidden" name="orden" value="<c:out value='${param.orden}'/>"><input type="hidden" name="direccion" value="<c:out value='${param.direccion}'/>"><input type="hidden" name="tamano" value="${tamano}"></form>
<div class="table-container"><table data-server-sort><thead><tr><th data-sort="codigo">Código</th><th data-sort="nombre">Estación</th><th>Ubicación</th><th data-sort="condicion">Condición operativa</th><th class="action-cell">Acciones</th></tr></thead><tbody><c:forEach var="e" items="${lista}"><tr><td class="cell-center"><c:out value="${e.codigo}"/><c:if test="${e.estado == 0}"><small class="crud-inactive">Registro deshabilitado</small></c:if></td><td><c:out value="${e.nombre}"/></td><td><c:out value="${e.ubicacion}"/></td><td><span class="status ${e.condicion == 'OPERATIVA' || e.condicion == 'OPERATIVO' ? 'ok' : e.condicion == 'FUERA_SERVICIO' ? 'danger' : 'info'}"><c:out value="${etiquetas[e.condicion]}"/></span></td><td class="action-cell"><div class="icon-actions"><a class="icon-action" title="Ver detalle" aria-label="Ver detalle" href="EstacionServlet?action=detalle&amp;id=${e.id}"><i class="fa-regular fa-eye" aria-hidden="true"></i></a><a class="icon-action edit" title="Editar registro" aria-label="Editar registro" href="EstacionServlet?action=editar&amp;id=${e.id}"><i class="fa-regular fa-pen-to-square" aria-hidden="true"></i></a><form method="post" action="EstacionServlet" data-confirm="Desactivar este registro? Se conservará el historial."><input type="hidden" name="action" value="borrar"><input type="hidden" name="id" value="${e.id}"><button class="icon-action danger" type="submit" title="Desactivar" aria-label="Desactivar"><i class="fa-solid fa-ban" aria-hidden="true"></i></button></form></div></td></tr></c:forEach><c:if test="${empty lista}"><tr><td colspan="5" class="crud-empty">No se encontraron registros.</td></tr></c:if></tbody></table></div>
<div class="table-pagination"><form method="get" action="EstacionServlet" class="pagination-size"><input type="hidden" name="orden" value="<c:out value='${param.orden}'/>"><input type="hidden" name="direccion" value="<c:out value='${param.direccion}'/>"><input type="hidden" name="paisFiltro" value="${paisFiltro == 0 ? '' : paisFiltro}"><label for="tamano">Mostrar</label><input type="hidden" name="q" value="<c:out value='${q}'/>"><input type="hidden" name="estado" value="<c:out value='${estadoFiltro}'/>"><select name="tamano" id="tamano" data-submit-on-change aria-label="Registros por página"><c:forEach var="cantidad" items="${[10,25,50]}"><option value="${cantidad}" ${tamano == cantidad ? 'selected' : ''}>${cantidad}</option></c:forEach></select><span>registros</span><noscript><button type="submit">Aplicar</button></noscript></form><div class="pagination-info" aria-live="polite">Mostrando ${desde}–${hasta} de ${total}</div><div class="pagination-controls" aria-label="Paginación">
<c:if test="${pagina == 1}"><button type="button" class="pagination-button" disabled aria-label="Página anterior">‹</button></c:if><c:if test="${pagina > 1}"><c:url var="anterior" value="/EstacionServlet"><c:param name="pagina" value="${pagina - 1}"/><c:param name="tamano" value="${tamano}"/><c:param name="q" value="${q}"/><c:param name="paisFiltro" value="${paisFiltro == 0 ? '' : paisFiltro}"/><c:param name="estado" value="${estadoFiltro}"/><c:param name="orden" value="${param.orden}"/><c:param name="direccion" value="${param.direccion}"/></c:url><a class="pagination-button" href="<c:out value='${anterior}'/>" aria-label="Página anterior">‹</a></c:if><span class="pagination-button active" aria-current="page" aria-label="Página ${pagina} de ${paginas}">${pagina}</span><c:if test="${pagina < paginas}"><c:url var="siguiente" value="/EstacionServlet"><c:param name="pagina" value="${pagina + 1}"/><c:param name="tamano" value="${tamano}"/><c:param name="q" value="${q}"/><c:param name="paisFiltro" value="${paisFiltro == 0 ? '' : paisFiltro}"/><c:param name="estado" value="${estadoFiltro}"/><c:param name="orden" value="${param.orden}"/><c:param name="direccion" value="${param.direccion}"/></c:url><a class="pagination-button" href="<c:out value='${siguiente}'/>" aria-label="Página siguiente">›</a></c:if><c:if test="${pagina == paginas}"><button type="button" class="pagination-button" disabled aria-label="Página siguiente">›</button></c:if></div></div></article><%@ include file="pie.jspf" %>
