<%@ page pageEncoding="UTF-8" %>
<% request.setAttribute("clasePagina","supervisor-view"); %><%@ include file="cabecera.jspf" %>
<div class="page-heading"><h1>Mantenimientos</h1><p>Consulte las intervenciones programadas, en ejecución y finalizadas sobre la infraestructura.</p></div>
<div class="cards supervisor-kpis"><article class="summary-card"><div class="metric-icon info"><i class="fa-regular fa-calendar"></i></div><span class="metric-label">Programados</span><strong><c:out value="${resumen[0]}"/></strong></article><article class="summary-card"><div class="metric-icon warning"><i class="fa-solid fa-screwdriver-wrench"></i></div><span class="metric-label">En ejecución</span><strong><c:out value="${resumen[1]}"/></strong></article><article class="summary-card"><div class="metric-icon info"><i class="fa-solid fa-link"></i></div><span class="metric-label">Servicios potenciales</span><strong><c:out value="${resumen[2]}"/></strong></article><article class="summary-card"><div class="metric-icon ok"><i class="fa-solid fa-circle-check"></i></div><span class="metric-label">Finalizados este mes</span><strong><c:out value="${resumen[3]}"/></strong></article></div>
<article class="panel"><div class="panel-heading"><div><h2>Intervenciones actuales</h2><p>Ventanas programadas, impacto y estado de ejecución.</p></div></div><div class="filter-panel"><div class="filter-grid"><div class="filter-field"><label for="ol-control-0">Filtrar por código</label><input placeholder="Ej. MNT-046" type="search" id="ol-control-0"></div><div class="filter-field"><label for="ol-control-1">Filtrar por infraestructura</label><input placeholder="Estación o segmento" type="search" id="ol-control-1"></div><div class="filter-field"><label for="ol-control-2">Filtrar por estado</label><select id="ol-control-2"><option selected="">Todos</option><option>Programado</option><option>En ejecución</option></select></div><div class="filter-field"><label for="ol-control-3">Filtrar por tipo</label><select id="ol-control-3"><option selected="">Todos</option><option>Preventivo</option><option>Correctivo</option></select></div><div class="filter-actions"><button class="primary-button filter-submit" type="button"><i class="fa-solid fa-filter"></i> Filtrar</button></div></div></div><div class="table-container"><table data-client-page class=""><thead><tr><th>Código</th><th>Tipo</th><th>Infraestructura</th><th>Ventana</th><th>Impacto</th><th>Estado</th></tr></thead><tbody><c:forEach var="fila" items="${tablas[0]}"><tr><c:forEach var="celda" items="${fila}" varStatus="col"><td><c:choose><c:when test="${fn:startsWith(celda,'LINK:')}"><a class="icon-action" title="Ver detalle" aria-label="Ver detalle" href="${fn:substringAfter(celda,'LINK:')}"><i class="fa-regular fa-eye"></i></a></c:when><c:otherwise><c:out value="${celda}"/></c:otherwise></c:choose></td></c:forEach></tr></c:forEach></tbody></table></div></article>
<article class="panel"><div class="panel-heading"><div><h2>Finalizados recientemente</h2><p>Últimos mantenimientos concluidos con comentario registrado.</p></div><a class="secondary-button" href="ConsultaServlet?vista=historicos&amp;menu=sup#mantenimientos"><i class="fa-solid fa-clock-rotate-left"></i> Ver histórico</a></div><div class="table-container"><table data-client-page class=""><thead><tr><th>Código</th><th>Infraestructura</th><th>Fecha</th><th>Comentario</th></tr></thead><tbody><c:forEach var="fila" items="${tablas[1]}"><tr><c:forEach var="celda" items="${fila}" varStatus="col"><td><c:choose><c:when test="${fn:startsWith(celda,'LINK:')}"><a class="icon-action" title="Ver detalle" aria-label="Ver detalle" href="${fn:substringAfter(celda,'LINK:')}"><i class="fa-regular fa-eye"></i></a></c:when><c:otherwise><c:out value="${celda}"/></c:otherwise></c:choose></td></c:forEach></tr></c:forEach></tbody></table></div></article>
<%@ include file="pie.jspf" %>
