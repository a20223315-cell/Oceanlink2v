<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %><div class="back-row"><a class="secondary-button" href="ServicioServlet"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Volver a servicios y rutas</a></div><div class="page-heading"><h1>${soloLectura ? 'Detalle' : registro.id > 0 ? 'Editar' : 'Registrar'} servicio</h1><p><c:choose><c:when test="${registro.id > 0}"><c:out value="${registro.codigo}"/></c:when><c:otherwise>Complete la información del registro.</c:otherwise></c:choose></p></div><c:if test="${not empty error}"><p class="crud-message crud-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><c:out value="${error}"/></p></c:if><c:if test="${param.ok == '1'}"><p class="crud-message crud-success" role="status">Operación realizada correctamente.</p></c:if><article class="panel"><div class="panel-heading"><div><h2>Datos de servicio</h2><p>Complete la información principal.</p></div></div><c:if test="${registro.estado == 'PENDIENTE'}"><p class="report-note crud-note">Este servicio se reserva y activa desde su solicitud. <a href="SolicitudServlet?action=editar&amp;id=${registro.solicitudId}">Gestionar solicitud</a></p></c:if><c:if test="${registro.id > 0}"><div class="detail-grid"><div class="detail-item"><strong>Cliente</strong><span><c:out value="${registro.clienteNombre}"/></span></div><div class="detail-item"><strong>Estado</strong><span class="status info"><c:out value="${etiquetas[registro.estado]}"/></span></div><div class="detail-item"><strong>Capacidad contratada</strong><span>${registro.capacidad} Tbps</span></div><div class="detail-item"><strong>Fecha de activación</strong><span><c:out value="${registro.fechaActivacionTexto}"/></span></div><div class="detail-item"><strong>Origen</strong><span><c:out value="${registro.origenNombre}"/></span></div><div class="detail-item"><strong>Destino</strong><span><c:out value="${registro.destinoNombre}"/></span></div><c:if test="${registro.estado == 'CANCELADO'}"><div class="detail-item"><strong>Fecha de cancelación</strong><span><c:out value="${registro.fechaCancelacionTexto}"/></span></div></c:if></div></c:if><div class="crud-form-body"><form method="post" action="ServicioServlet" class="crud-form" data-confirm="¿Guardar los datos de este registro?" id="registro-form"><input type="hidden" name="action" value="${registro.id > 0 ? 'actualizar' : 'crear'}"><input type="hidden" name="id" value="${registro.id}"><fieldset class="crud-fields" ${soloLectura ? 'disabled' : ''}><c:choose><c:when test="${registro.id == 0}"><div class="form-field"><label for="solicitudId">Solicitud provisionada</label><select id="solicitudId" name="solicitudId" required><option value="" disabled ${empty param.solicitudId && registro.solicitudId == 0 ? 'selected' : ''}>Seleccione</option><c:forEach var="opcion" items="${solicitudes}"><option value="${opcion.id}" ${(param.solicitudId != null ? param.solicitudId : registro.solicitudId) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></div><p class="report-note crud-wide">Al activar se utiliza la ruta y la capacidad ya reservada de la solicitud.</p></c:when><c:otherwise><div class="crud-wide report-note">Cliente: <c:out value="${registro.clienteNombre}"/> · Capacidad contratada: ${registro.capacidad} Tbps · Estado: <c:out value="${etiquetas[registro.estado]}"/></div><input type="hidden" id="origenId" value="${registro.origenId}"><input type="hidden" id="destinoId" value="${registro.destinoId}"><div class="form-field crud-wide"><label for="ruta">Ruta asignada</label><select name="ruta" id="ruta" required><option value="">Seleccione origen y destino</option><c:forEach var="ruta" items="${rutas}"><option value="${ruta.key}" ${(param.ruta != null ? param.ruta : registro.ruta) == ruta.key ? 'selected' : ''}><c:out value="${ruta.value}"/></option></c:forEach></select><small data-route-status aria-live="polite">Seleccione la ruta que conecta las estaciones.</small></div></c:otherwise></c:choose></fieldset><c:if test="${!soloLectura}"><div class="form-actions"><a class="danger-button" href="ServicioServlet">Cancelar</a><button type="submit" class="primary-button"><i class="fa-solid fa-check" aria-hidden="true"></i>Guardar servicio</button></div></c:if></form><c:if test="${soloLectura && registro.estado == 'ACTIVO' && menu != 'sup'}"><div class="detail-actions"><a class="primary-button" href="ServicioServlet?action=editar&amp;id=${registro.id}" title="Gestionar ruta"><i class="fa-solid fa-route"></i>Gestionar ruta</a><form method="post" action="ServicioServlet" data-confirm="¿Cancelar el servicio? Su capacidad se liberará en todos los segmentos de la ruta."><input type="hidden" name="action" value="borrar"><input type="hidden" name="id" value="${registro.id}"><input type="hidden" name="returnDetail" value="1"><button class="danger-button" type="submit">Cancelar servicio</button></form></div></c:if></div></article><c:if test="${registro.id > 0}"><article class="panel crud-related"><div class="panel-heading"><div><h2>Ruta asignada</h2><p>Segmentos utilizados por el servicio.</p></div></div><div class="table-container"><table data-client-page><thead><tr><th>Orden</th><th>Segmento</th><th>Origen</th><th>Destino</th><th>Capacidad (Tbps)</th><th>Condición</th></tr></thead><tbody><c:forEach var="fila" items="${detalleRuta}"><tr><c:forEach var="celda" items="${fila}"><td><c:out value="${celda}"/></td></c:forEach></tr></c:forEach></tbody></table></div><p class="helper-note">Al cancelar el servicio, la capacidad utilizada se libera y vuelve a estar disponible.</p></article></c:if><%@ include file="pie.jspf" %>
