<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %><div class="back-row"><a class="secondary-button" href="IncidenciaServlet"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Volver a gestión de incidencias</a></div><div class="page-heading"><h1>${soloLectura ? 'Detalle' : registro.id > 0 ? 'Editar' : 'Registrar'} incidencia</h1><p><c:choose><c:when test="${registro.id > 0}"><c:out value="${registro.codigo}"/></c:when><c:otherwise>Complete la información del registro.</c:otherwise></c:choose></p></div><c:if test="${not empty error}"><p class="crud-message crud-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><c:out value="${error}"/></p></c:if><c:if test="${param.ok == '1'}"><p class="crud-message crud-success" role="status">Operación realizada correctamente.</p></c:if><article class="panel"><div class="panel-heading"><div><h2>Datos de incidencia</h2><p>Complete la información principal.</p></div></div><div class="crud-form-body"><form method="post" action="IncidenciaServlet" class="crud-form" data-workflow="incidencia" data-current-state="${registro.fase}" id="registro-form"><input type="hidden" name="action" value="${registro.id > 0 ? 'actualizar' : 'crear'}"><input type="hidden" name="id" value="${registro.id}"><fieldset class="crud-fields" ${soloLectura ? 'disabled' : ''}><div class="form-field"><label for="severidad">Severidad</label><select id="severidad" name="severidad" required><option value="" disabled>Seleccione</option><option value="BAJA" ${(param.severidad != null ? param.severidad : registro.severidad) == 'BAJA' ? 'selected' : ''}>Baja</option><option value="MEDIA" ${(param.severidad != null ? param.severidad : registro.severidad) == 'MEDIA' ? 'selected' : ''}>Media</option><option value="ALTA" ${(param.severidad != null ? param.severidad : registro.severidad) == 'ALTA' ? 'selected' : ''}>Alta</option><option value="CRITICA" ${(param.severidad != null ? param.severidad : registro.severidad) == 'CRITICA' ? 'selected' : ''}>Crítica</option></select></div><div class="form-field"><label for="fase">Estado</label><select id="fase" name="fase" required><option value="" disabled>Seleccione</option><option value="DETECTADA" ${fn:contains(permitidos,'DETECTADA') ? '' : 'disabled'} ${(param.fase != null ? param.fase : registro.fase) == 'DETECTADA' ? 'selected' : ''}>Detectada</option><option value="EN_ANALISIS" ${fn:contains(permitidos,'EN_ANALISIS') ? '' : 'disabled'} ${(param.fase != null ? param.fase : registro.fase) == 'EN_ANALISIS' ? 'selected' : ''}>En análisis</option><option value="REPARACION_PROGRAMADA" ${fn:contains(permitidos,'REPARACION_PROGRAMADA') ? '' : 'disabled'} ${(param.fase != null ? param.fase : registro.fase) == 'REPARACION_PROGRAMADA' ? 'selected' : ''}>Reparación programada</option><option value="EN_REPARACION" ${fn:contains(permitidos,'EN_REPARACION') ? '' : 'disabled'} ${(param.fase != null ? param.fase : registro.fase) == 'EN_REPARACION' ? 'selected' : ''}>En reparación</option><option value="RESTAURADA" ${fn:contains(permitidos,'RESTAURADA') ? '' : 'disabled'} ${(param.fase != null ? param.fase : registro.fase) == 'RESTAURADA' ? 'selected' : ''}>Restaurada</option><option value="CERRADA" ${fn:contains(permitidos,'CERRADA') ? '' : 'disabled'} ${(param.fase != null ? param.fase : registro.fase) == 'CERRADA' ? 'selected' : ''}>Cerrada</option></select></div><div class="form-field"><label for="deteccion">Fecha de detección</label><input id="deteccion" name="deteccion" type="datetime-local" maxlength="30" required value="<c:out value='${param.deteccion != null ? param.deteccion : registro.deteccion}'/>"></div><div class="form-field"><label for="restauracion">Restauración</label><input id="restauracion" name="restauracion" type="datetime-local" maxlength="30" value="<c:out value='${param.restauracion != null ? param.restauracion : registro.restauracion}'/>"></div><div class="form-field"><label for="cierre">Cierre</label><input id="cierre" name="cierre" type="datetime-local" maxlength="30" value="<c:out value='${param.cierre != null ? param.cierre : registro.cierre}'/>"></div><div class="form-field"><label for="creadoPor">Registrado por</label><select id="creadoPor" name="creadoPor" required><option value="" disabled>Seleccione</option><c:forEach var="opcion" items="${usuarios}"><option value="${opcion.id}" ${(param.creadoPor != null ? param.creadoPor : registro.creadoPor) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></div><div class="form-field"><label for="descripcion">Descripción</label><textarea id="descripcion" name="descripcion" rows="3" maxlength="2000" required><c:out value="${param.descripcion != null ? param.descripcion : registro.descripcion}"/></textarea></div><c:set var="seleccionRuta" value=",${registro.ruta},"/><div class="form-field crud-wide"><span class="crud-label">Segmentos afectados</span><div class="crud-checks"><c:forEach var="segmento" items="${segmentos}"><c:set var="segmentoClave" value=",${segmento.id},"/><label><input type="checkbox" name="segmentos" value="${segmento.id}" <c:if test="${param.action == 'crear' || param.action == 'actualizar'}"><c:forEach var="seleccionado" items="${paramValues.segmentos}"><c:if test="${seleccionado == segmento.id}">checked</c:if></c:forEach></c:if><c:if test="${param.action != 'crear' && param.action != 'actualizar' && fn:contains(seleccionRuta,segmentoClave)}">checked</c:if>><c:out value="${segmento.nombre}"/></label></c:forEach></div></div><div class="form-field"><label for="observacion">Observación de atención</label><textarea id="observacion" name="observacion" rows="3" maxlength="2000"><c:out value="${param.observacion}"/></textarea></div><div class="form-field"><label for="resultado">Resultado de cierre</label><textarea id="resultado" name="resultado" rows="3" maxlength="2000"><c:out value="${param.resultado != null ? param.resultado : registro.resultado}"/></textarea></div></fieldset><c:if test="${!soloLectura}"><div class="form-actions"><a class="danger-button" href="IncidenciaServlet">Cancelar</a><button type="submit" class="primary-button"><i class="fa-solid fa-check" aria-hidden="true"></i>Guardar incidencia</button></div></c:if></form></div></article><article class="panel crud-related"><div class="panel-heading"><div><h2>Servicios y clientes potencialmente afectados</h2><p>Servicios activos que utilizan la infraestructura seleccionada.</p></div></div><div class="table-container"><table data-client-page><thead><tr><th>Servicio</th><th>Cliente</th><th>Capacidad (Tbps)</th><th>Estado</th></tr></thead><tbody><c:forEach var="fila" items="${afectados}"><tr><c:forEach var="celda" items="${fila}"><td><c:out value="${celda}"/></td></c:forEach></tr></c:forEach><c:if test="${empty afectados}"><tr><td colspan="4" class="crud-empty">Sin servicios activos afectados.</td></tr></c:if></tbody></table></div></article>
<c:if test="${registro.id > 0}"><article class="panel crud-related"><div class="panel-heading"><h2>Historial de atención</h2></div><div class="table-container"><table data-client-page><thead><tr><th>Estado / actividad</th><th>Fecha</th><th>Descripción</th><th>Registrado por</th></tr></thead><tbody><c:forEach var="fila" items="${bitacora}"><tr><c:forEach var="celda" items="${fila}"><td><c:out value="${celda}"/></td></c:forEach></tr></c:forEach></tbody></table></div></article></c:if><%@ include file="pie.jspf" %>
