<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %><div class="page-heading"><h1><c:out value="${titulo}"/></h1><p>Información de la infraestructura y operación de OceanLink.</p></div><c:if test="${not empty indicadores}"><div class="crud-cards"><c:forEach var="indicador" items="${indicadores}"><article class="panel crud-card"><i class="fa-solid fa-chart-simple" aria-hidden="true"></i><span><strong><c:out value="${indicador[1]}"/></strong><small><c:out value="${indicador[0]}"/></small></span></article></c:forEach></div></c:if><article class="panel crud-related"><div class="panel-heading"><div><h2><c:out value="${titulo}"/></h2><p>Consulte los datos registrados y la capacidad disponible.</p></div></div><div class="filter-panel"><div class="filter-grid"><div class="filter-field"><label for="consultaBuscar">Buscar en los resultados</label><input type="search" id="consultaBuscar" data-table-search placeholder="Código, nombre o estado"></div><c:if test="${param.vista == 'capacidad' || param.vista == 'red' || empty param.vista || param.vista == 'general'}"><div class="filter-field"><label for="utilizacion">Filtrar por utilización</label><select id="utilizacion" data-utilizacion><option value="">Todos</option><option value="Normal">Normal (&lt;80%)</option><option value="Alta utilización">Alta (80%–95%)</option><option value="Utilización crítica">Crítica (&gt;95%)</option></select></div></c:if></div></div><div class="table-container"><table data-client-page><thead><tr><c:forEach var="columna" items="${columnas}"><th><c:out value="${columna}"/></th></c:forEach></tr></thead><tbody><c:forEach var="fila" items="${filas}"><tr><c:forEach var="celda" items="${fila}"><td><c:out value="${celda}"/></td></c:forEach></tr></c:forEach></tbody></table></div></article><%@ include file="pie.jspf" %>
