<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %><div class="back-row"><a class="secondary-button" href="MantenimientoServlet"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Volver a gestión de mantenimiento</a></div><div class="page-heading"><h1>${soloLectura ? 'Detalle' : registro.id > 0 ? 'Editar' : 'Registrar'} mantenimiento</h1><p><c:choose><c:when test="${registro.id > 0}"><c:out value="${registro.codigo}"/></c:when><c:otherwise>Complete la información del registro.</c:otherwise></c:choose></p></div><c:if test="${not empty error}"><p class="crud-message crud-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><c:out value="${error}"/></p></c:if><c:if test="${param.ok == '1'}"><p class="crud-message crud-success" role="status">Operación realizada correctamente.</p></c:if><article class="panel"><div class="panel-heading"><div><h2>Datos de mantenimiento</h2><p>Complete la información principal.</p></div></div><div class="crud-form-body"><form method="post" action="MantenimientoServlet" class="crud-form" data-workflow="mantenimiento" data-current-state="${registro.fase}" id="registro-form"><input type="hidden" name="action" value="${registro.id > 0 ? 'actualizar' : 'crear'}"><input type="hidden" name="id" value="${registro.id}"><fieldset class="crud-fields" ${soloLectura ? 'disabled' : ''}><div class="form-field"><label for="tipoId">Tipo de mantenimiento</label><select id="tipoId" name="tipoId" required><option value="" disabled ${empty param.tipoId && registro.tipoId == 0 ? 'selected' : ''}>Seleccione</option><c:forEach var="opcion" items="${tipos}"><option value="${opcion.id}" ${(param.tipoId != null ? param.tipoId : registro.tipoId) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></div><div class="form-field"><label for="estacionId">Estación</label><select id="estacionId" name="estacionId"><option value="">Sin seleccionar</option><c:forEach var="opcion" items="${estaciones}"><option value="${opcion.id}" ${(param.estacionId != null ? param.estacionId : registro.estacionId) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></div><div class="form-field"><label for="segmentoId">Segmento</label><select id="segmentoId" name="segmentoId"><option value="">Sin seleccionar</option><c:forEach var="opcion" items="${segmentos}"><option value="${opcion.id}" ${(param.segmentoId != null ? param.segmentoId : registro.segmentoId) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></div><div class="form-field"><label for="fase">Estado</label><select id="fase" name="fase" required><option value="" disabled>Seleccione</option><option value="PROGRAMADO" ${fn:contains(permitidos,'PROGRAMADO') ? '' : 'disabled'} ${(param.fase != null ? param.fase : registro.fase) == 'PROGRAMADO' ? 'selected' : ''}>Programado</option><option value="EN_PROGRESO" ${fn:contains(permitidos,'EN_PROGRESO') ? '' : 'disabled'} ${(param.fase != null ? param.fase : registro.fase) == 'EN_PROGRESO' ? 'selected' : ''}>En progreso</option><option value="FINALIZADO" ${fn:contains(permitidos,'FINALIZADO') ? '' : 'disabled'} ${(param.fase != null ? param.fase : registro.fase) == 'FINALIZADO' ? 'selected' : ''}>Finalizado</option></select></div><div class="form-field"><label for="inicio">Inicio programado</label><input id="inicio" name="inicio" type="datetime-local" maxlength="30" required value="<c:out value='${param.inicio != null ? param.inicio : registro.inicio}'/>"></div><div class="form-field"><label for="fin">Fin programado</label><input id="fin" name="fin" type="datetime-local" maxlength="30" required value="<c:out value='${param.fin != null ? param.fin : registro.fin}'/>"></div><div class="form-field"><label for="inicioReal">Inicio real</label><input id="inicioReal" name="inicioReal" type="datetime-local" maxlength="30" value="<c:out value='${param.inicioReal != null ? param.inicioReal : registro.inicioReal}'/>"></div><div class="form-field"><label for="cierre">Fecha de cierre</label><input id="cierre" name="cierre" type="datetime-local" maxlength="30" value="<c:out value='${param.cierre != null ? param.cierre : registro.cierre}'/>"></div><div class="form-field"><label for="creadoPor">Registrado por</label><select id="creadoPor" name="creadoPor" required><option value="" disabled>Seleccione</option><c:forEach var="opcion" items="${usuarios}"><option value="${opcion.id}" ${(param.creadoPor != null ? param.creadoPor : registro.creadoPor) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></div><div class="form-field"><label for="descripcion">Descripción</label><textarea id="descripcion" name="descripcion" rows="3" maxlength="2000" required><c:out value="${param.descripcion != null ? param.descripcion : registro.descripcion}"/></textarea></div><div class="form-field"><label for="actividad">Actividad realizada</label><textarea id="actividad" name="actividad" rows="3" maxlength="2000"><c:out value="${param.actividad}"/></textarea></div><div class="form-field"><label for="resultado">Resultado</label><textarea id="resultado" name="resultado" rows="3" maxlength="2000"><c:out value="${param.resultado != null ? param.resultado : registro.resultado}"/></textarea></div></fieldset><c:if test="${!soloLectura}"><div class="form-actions"><a class="danger-button" href="MantenimientoServlet">Cancelar</a><button type="submit" class="primary-button"><i class="fa-solid fa-check" aria-hidden="true"></i>Guardar mantenimiento</button></div></c:if></form></div></article><article class="panel crud-related"><div class="panel-heading"><div><h2>Servicios y clientes potencialmente afectados</h2><p>Servicios activos que utilizan la infraestructura seleccionada.</p></div><button type="button" class="secondary-button" data-impacto>Consultar impacto</button></div><div class="table-container"><table data-client-page><thead><tr><th>Servicio</th><th>Cliente</th><th>Capacidad (Tbps)</th><th>Estado</th></tr></thead><tbody data-impacto-tabla><c:forEach var="fila" items="${afectados}"><tr><c:forEach var="celda" items="${fila}"><td><c:out value="${celda}"/></td></c:forEach></tr></c:forEach><c:if test="${empty afectados}"><tr><td colspan="4" class="crud-empty">Sin servicios activos afectados.</td></tr></c:if></tbody></table></div></article>
<c:if test="${registro.id > 0}"><article class="panel crud-related"><div class="panel-heading"><h2>Historial de atención</h2></div><div class="table-container"><table data-client-page><thead><tr><th>Estado / actividad</th><th>Fecha</th><th>Descripción</th><th>Registrado por</th></tr></thead><tbody><c:forEach var="fila" items="${bitacora}"><tr><c:forEach var="celda" items="${fila}"><td><c:out value="${celda}"/></td></c:forEach></tr></c:forEach></tbody></table></div></article></c:if><%@ include file="pie.jspf" %>
