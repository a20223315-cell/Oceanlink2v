<%@ page pageEncoding="UTF-8" %>
<% request.setAttribute("clasePagina","supervisor-view"); %><%@ include file="cabecera.jspf" %><div class="page-heading"><h1>Generación de reportes</h1><p>Consultas operativas por tipo, alcance y periodo, con versión PDF.</p></div>
<article class="panel report-criteria-panel report-criteria-panel--compact"><div class="panel-heading report-criteria-heading"><div><h2>Criterios del reporte</h2><p>Tipo de información, alcance y rango temporal de la consulta.</p></div><button class="primary-button report-preview-action" form="criterios-reporte" type="submit"><i class="fa-regular fa-eye"></i> Previsualizar reporte</button></div><form class="report-builder-form" id="criterios-reporte" action="ReporteServlet" method="get"><div class="report-criteria-grid report-criteria-grid--compact">
<div class="form-field report-type-field"><label for="ol-control-0">Tipo de reporte</label><select name="tipo" class="report-type-select" required="" id="ol-control-0"><option value="OPERACION_GENERAL">Operación general</option><option value="CAPACIDAD_UTILIZACION">Capacidad y utilización</option><option value="INCIDENCIAS">Incidencias</option><option value="MANTENIMIENTOS">Mantenimientos</option><option value="SERVICIOS_CLIENTES">Servicios y clientes</option><option value="INDICADORES_HISTORICOS">Indicadores históricos</option></select></div>
<div class="form-field report-scope-field"><label for="ol-control-1">Alcance</label><select name="segmento" class="report-segment-select" id="ol-control-1"><option value="" selected="">Toda la red</option><c:forEach var="opcion" items="${alcances}"><option value="${opcion[0]}"><c:out value="${opcion[1]}"/></option></c:forEach></select></div>
<div class="form-field"><label for="ol-control-2">Fecha inicial</label><input name="desde" class="report-start-date" required="" type="date" value="2026-08-20" id="ol-control-2"></div><div class="form-field"><label for="ol-control-3">Fecha final</label><input name="hasta" class="report-end-date" required="" type="date" value="2026-09-30" id="ol-control-3"></div>
</div></form></article>
<article class="panel report-history-panel"><div class="panel-heading"><div><h2>Historial de reportes</h2><p>Reportes generados y sus versiones en PDF.</p></div><span class="history-counter"><i class="fa-regular fa-clock"></i> Actividad reciente</span></div><div class="table-container"><table data-client-page class=""><thead><tr><th>Reporte</th><th>Alcance</th><th>Periodo</th><th>Generado por</th><th>Fecha y hora</th><th class="action-cell">Acciones</th></tr></thead><tbody><c:forEach var="fila" items="${tablas[0]}"><tr><c:forEach var="celda" items="${fila}" varStatus="col"><td><c:choose><c:when test="${fn:startsWith(celda,'LINK:')}"><a class="icon-action" title="Ver detalle" aria-label="Ver detalle" href="${fn:substringAfter(celda,'LINK:')}"><i class="fa-regular fa-eye"></i></a></c:when><c:otherwise><c:out value="${celda}"/></c:otherwise></c:choose></td></c:forEach></tr></c:forEach></tbody></table></div></article><%@ include file="pie.jspf" %>
