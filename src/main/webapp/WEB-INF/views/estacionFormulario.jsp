<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %><div class="back-row"><a class="secondary-button" href="EstacionServlet"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Volver a estaciones de aterrizaje</a></div><div class="page-heading"><h1>${soloLectura ? 'Detalle' : registro.id > 0 ? 'Editar' : 'Registrar'} estación</h1><p><c:choose><c:when test="${registro.id > 0}"><c:out value="${registro.codigo}"/></c:when><c:otherwise>Complete la información del registro.</c:otherwise></c:choose></p></div><c:if test="${not empty error}"><p class="crud-message crud-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><c:out value="${error}"/></p></c:if><c:if test="${param.ok == '1'}"><p class="crud-message crud-success" role="status">Operación realizada correctamente.</p></c:if><article class="panel"><div class="panel-heading"><div><h2>Datos de estación</h2><p>El código se genera con el país y el número de registro.</p></div></div><div class="crud-form-body"><form method="post" action="EstacionServlet" class="crud-form" data-confirm="¿Guardar los datos de este registro?" id="registro-form"><input type="hidden" name="action" value="${registro.id > 0 ? 'actualizar' : 'crear'}"><input type="hidden" name="id" value="${registro.id}"><fieldset class="crud-fields" ${soloLectura ? 'disabled' : ''}><div class="form-field"><label for="nombre">Nombre de estación</label><input id="nombre" name="nombre" type="text" maxlength="150" required value="<c:out value='${param.nombre != null ? param.nombre : registro.nombre}'/>"></div><div class="form-field"><label for="ubicacion">Ubicación</label><c:choose><c:when test="${registro.id > 0}"><input id="ubicacion" readonly aria-readonly="true" value="<c:out value='${registro.ubicacion}'/>"></c:when><c:otherwise><input id="ubicacion" name="ubicacion" type="text" maxlength="160" required value="<c:out value='${param.ubicacion != null ? param.ubicacion : registro.ubicacion}'/>"></c:otherwise></c:choose></div><div class="form-field"><label for="paisId">País</label><c:choose><c:when test="${registro.id > 0}"><input id="paisId" readonly aria-readonly="true" value="<c:out value='${registro.pais.nombre}'/>"></c:when><c:otherwise><select id="paisId" name="paisId" required><option value="" disabled ${empty param.paisId && registro.paisId == 0 ? 'selected' : ''}>Seleccione</option><c:forEach var="opcion" items="${paises}"><option value="${opcion.id}" ${(param.paisId != null ? param.paisId : registro.paisId) == opcion.id ? 'selected' : ''}><c:out value="${opcion.nombre}"/></option></c:forEach></select></c:otherwise></c:choose></div><div class="form-field"><label for="capacidad">Capacidad de energía (kW)</label><input id="capacidad" name="capacidad" type="number" maxlength="30" required step="0.001" min="0.001" value="<c:out value='${param.capacidad != null ? param.capacidad : registro.capacidad}'/>"></div><div class="form-field"><label for="condicion">Condición operativa</label><select id="condicion" name="condicion" required><option value="" disabled>Seleccione</option><option value="OPERATIVA" ${(param.condicion != null ? param.condicion : registro.condicion) == 'OPERATIVA' ? 'selected' : ''}>Operativa</option><option value="EN_MANTENIMIENTO" ${(param.condicion != null ? param.condicion : registro.condicion) == 'EN_MANTENIMIENTO' ? 'selected' : ''}>En mantenimiento</option><option value="FUERA_SERVICIO" ${(param.condicion != null ? param.condicion : registro.condicion) == 'FUERA_SERVICIO' ? 'selected' : ''}>Fuera de servicio</option></select></div><div class="form-field"><label for="estado">Habilitación del registro</label><input id="estado" readonly aria-readonly="true" value="${registro.id == 0 || registro.estado == 1 ? 'Habilitado' : 'Deshabilitado'}"></div></fieldset><c:if test="${registro.id > 0 and !soloLectura}"><p class="crud-note">País y ubicación se conservan como datos de la instalación. La baja del registro se gestiona desde la tabla.</p></c:if><c:if test="${!soloLectura}"><div class="form-actions"><a class="danger-button" href="EstacionServlet">Cancelar</a><button type="submit" class="primary-button"><i class="fa-solid fa-check" aria-hidden="true"></i>Guardar estación</button></div></c:if></form></div></article><%@ include file="pie.jspf" %>
