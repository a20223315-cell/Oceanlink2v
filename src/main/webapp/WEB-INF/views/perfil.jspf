<%@ page pageEncoding="UTF-8" %>
<div class="modal" id="mi-perfil" role="dialog" aria-modal="true" aria-labelledby="perfil-titulo" hidden>
<button class="modal-background" type="button" data-profile-close aria-label="Cerrar perfil"></button>
<div class="modal-box user-profile-modal"><div class="modal-header"><div><span class="modal-eyebrow">MI PERFIL</span><h2 id="perfil-titulo">Información general</h2></div><button class="modal-close" type="button" data-profile-close aria-label="Cerrar"><i class="fa-solid fa-xmark"></i></button></div>
<div class="modal-body"><c:choose><c:when test="${not empty perfil}">
<div class="user-profile-hero"><div class="user-avatar" data-initials><c:out value="${perfil.nombreOrdenado}"/></div><div class="user-profile-heading"><h3><c:out value="${perfil.nombreOrdenado}"/></h3><p><c:out value="${perfil.rolNombre}"/></p><div class="user-country-state"><span class="user-country"><img class="country-flag" src="${pageContext.request.contextPath}/assets/flags/${fn:toLowerCase(perfil.paisCodigo)}.svg" alt=""> <c:out value="${perfil.paisNombre}"/></span><span class="status ok">Activo</span></div></div></div>
<p class="help-text">Puedes actualizar tu número de celular desde este perfil.</p>
<div class="user-profile-grid"><div class="profile-data"><i class="fa-solid fa-id-badge"></i><span><small>CÓDIGO</small><strong><c:out value="${perfil.codigo}"/></strong></span></div><div class="profile-data"><i class="fa-regular fa-calendar"></i><span><small>FECHA DE INGRESO</small><strong data-profile-date>${fn:substring(perfil.fechaIngreso,0,10)}</strong></span></div><div class="profile-data"><i class="fa-regular fa-envelope"></i><span><small>CORREO</small><strong><c:out value="${perfil.correo}"/></strong></span></div><div class="profile-data"><i class="fa-solid fa-phone"></i><span><small>CELULAR</small><strong data-profile-phone><c:out value="${perfil.telefono}"/></strong><form id="perfil-contacto" action="${pageContext.request.contextPath}/PerfilServlet" method="post" data-profile-form hidden><div class="phone-field profile-inline-field"><select name="telefonoRegion" class="phone-region" aria-label="País del celular" required><option value="">Prefijo</option><c:forEach var="pt" items="${paisesTelefono}"><option value="${pt.codigo()}" data-country="${pt.codigo()}" data-prefix="${pt.prefijo()}" ${param.telefonoRegion != null ? (param.telefonoRegion == pt.codigo() ? 'selected' : '') : (perfil.telefonoRegion == pt.codigo() ? 'selected' : '')}><c:out value="${pt.nombre()}"/> (${pt.prefijo()})</option></c:forEach></select><input aria-label="Número de celular" class="profile-contact-input" id="perfilTelefono" name="telefono" type="tel" required inputmode="tel" maxlength="20" value="<c:out value='${perfil.telefonoLocal}'/>"></div></form></span></div></div>

<p role="status" data-profile-status></p><div class="form-actions"><button class="danger-button" type="button" data-profile-cancel hidden>Cancelar</button><button class="primary-button" type="submit" form="perfil-contacto" data-profile-save hidden><i class="fa-solid fa-floppy-disk"></i>Guardar cambios</button><button class="secondary-button" type="button" data-profile-edit><i class="fa-regular fa-pen-to-square"></i>Editar datos</button></div>
</c:when><c:otherwise><p>No existe un usuario activo para esta área. Regístralo desde Usuarios para disponer de un perfil de demostración.</p></c:otherwise></c:choose></div></div></div>
