<%@ page pageEncoding="UTF-8" %>
<% request.setAttribute("clasePagina","supervisor-view"); %><%@ include file="cabecera.jspf" %>
<div class="page-heading"><h1>Red y capacidad</h1><p>Consulte todos los segmentos de la red, su estado operativo y la distribución de capacidad.</p></div>
<div class="cards supervisor-kpis"><article class="summary-card"><div class="metric-icon info"><i class="fa-solid fa-percent"></i></div><span class="metric-label">Utilización promedio</span><strong><c:out value="${resumen[0]}"/></strong></article><article class="summary-card"><div class="metric-icon danger"><i class="fa-solid fa-gauge-high"></i></div><span class="metric-label">Segmentos críticos</span><strong><c:out value="${resumen[1]}"/></strong></article><article class="summary-card"><div class="metric-icon warning"><i class="fa-solid fa-wave-square"></i></div><span class="metric-label">Alta utilización</span><strong><c:out value="${resumen[2]}"/></strong></article><article class="summary-card"><div class="metric-icon info"><i class="fa-solid fa-database"></i></div><span class="metric-label">Capacidad disponible</span><strong><c:out value="${resumen[3]}"/></strong></article></div>
<article class="panel"><div class="panel-heading"><div><h2>Estado actual de los segmentos</h2><p>Utilización y estado operativo consolidados por tramo.</p></div></div><div class="filter-panel"><div class="filter-grid filter-grid--capacity"><div class="filter-field"><label for="ol-control-0">Filtrar por segmento</label><input placeholder="Ej. SEG-103" type="search" id="ol-control-0"></div><div class="filter-field"><label for="ol-control-1">Filtrar por utilización</label><select id="ol-control-1"><option selected="">Todos</option><option value="Normal">Normal (&lt;80%)</option><option value="Alta">Alta (80%–95%)</option><option value="Crítica">Crítica (&gt;95%)</option></select></div><div class="filter-field"><label for="ol-control-2">Filtrar por estado actual</label><select id="ol-control-2"><option selected="">Todos</option><option>Operativo</option><option>Degradado</option><option>En mantenimiento</option><option>Fuera de servicio</option></select></div><div class="filter-actions"><button class="primary-button filter-submit" type="button"><i class="fa-solid fa-filter"></i> Filtrar</button></div></div></div><div class="table-container"><table data-client-page class="supervisor-capacity-table"><thead><tr><th>Segmento</th><th>Ruta</th><th>Utilización (%)</th><th>Estado actual</th><th class="action-cell">Acción</th></tr></thead><tbody><c:forEach var="fila" items="${tablas[0]}"><tr><c:forEach var="celda" items="${fila}" varStatus="col"><td><c:choose><c:when test="${fn:startsWith(celda,'LINK:')}"><a class="icon-action" title="Ver detalle" aria-label="Ver detalle" href="${fn:substringAfter(celda,'LINK:')}"><i class="fa-regular fa-eye"></i></a></c:when><c:otherwise><c:out value="${celda}"/></c:otherwise></c:choose></td></c:forEach></tr></c:forEach></tbody></table></div></article>
<%@ include file="pie.jspf" %>
