<%@ page pageEncoding="UTF-8" %>
<%@ include file="cabecera.jspf" %><div class="back-row"><a class="secondary-button" href="ClienteServlet"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i>Volver a clientes empresariales</a></div><div class="page-heading"><h1>${soloLectura ? 'Detalle' : registro.id > 0 ? 'Editar' : 'Registrar'} cliente</h1><p><c:choose><c:when test="${registro.id > 0}"><c:out value="${registro.codigo}"/></c:when><c:otherwise>Complete la información del registro.</c:otherwise></c:choose></p></div><c:if test="${not empty error}"><p class="crud-message crud-error" role="alert"><i class="fa-solid fa-circle-exclamation" aria-hidden="true"></i><c:out value="${error}"/></p></c:if><c:if test="${param.ok == '1'}"><p class="crud-message crud-success" role="status">Operación realizada correctamente.</p></c:if><article class="panel"><div class="panel-heading"><div><h2>Datos de cliente</h2><p>Complete la información principal.</p></div></div><div class="crud-form-body"><form method="post" action="ClienteServlet" class="crud-form" data-confirm="¿Guardar los datos de este registro?" id="registro-form"><input type="hidden" name="action" value="${registro.id > 0 ? 'actualizar' : 'crear'}"><input type="hidden" name="id" value="${registro.id}"><fieldset class="crud-fields" ${soloLectura ? 'disabled' : ''}><div class="form-field"><label for="nombre">Razón social</label><input id="nombre" name="nombre" type="text" maxlength="180" required value="<c:out value='${param.nombre != null ? param.nombre : registro.nombre}'/>"></div><div class="form-field"><label for="tipoDocumento">Tipo de identificación</label><input id="tipoDocumento" name="tipoDocumento" type="text" maxlength="20" required value="<c:out value='${param.tipoDocumento != null ? param.tipoDocumento : registro.tipoDocumento}'/>"></div><div class="form-field"><label for="documento">Identificación fiscal</label><input id="documento" name="documento" type="text" maxlength="40" required value="<c:out value='${param.documento != null ? param.documento : registro.documento}'/>"></div><div class="form-field"><label for="contacto">Nombre de contacto</label><input id="contacto" name="contacto" type="text" maxlength="160" required value="<c:out value='${param.contacto != null ? param.contacto : registro.contacto}'/>"></div><div class="form-field"><label for="correo">Correo de contacto</label><input id="correo" name="correo" type="email" maxlength="254" required value="<c:out value='${param.correo != null ? param.correo : registro.correo}'/>"></div><div class="form-field"><label for="telefono">Teléfono</label><input id="telefono" name="telefono" type="tel" required maxlength="30" value="<c:out value='${param.telefono != null ? param.telefono : registro.telefono}'/>"></div><div class="form-field"><label for="estado">Estado</label><select id="estado" name="estado" required><option value="" disabled>Seleccione</option><option value="1" ${(param.estado != null ? param.estado : registro.estado) == '1' ? 'selected' : ''}>Activo</option><option value="0" ${(param.estado != null ? param.estado : registro.estado) == '0' ? 'selected' : ''}>Inactivo</option></select></div></fieldset><c:if test="${!soloLectura}"><div class="form-actions"><a class="danger-button" href="ClienteServlet">Cancelar</a><button type="submit" class="primary-button"><i class="fa-solid fa-check" aria-hidden="true"></i>Guardar cliente</button></div></c:if></form></div></article><%@ include file="pie.jspf" %>
