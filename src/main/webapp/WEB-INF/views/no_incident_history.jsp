<%@ page pageEncoding="UTF-8" %><%@ include file="cabecera.jspf" %>
<div class="page-heading"><h1>Historial de incidencias</h1><p>Consulte incidencias cerradas y la trazabilidad de su atención y restauración.</p></div>
<article class="panel"><div class="panel-heading"><div><h2>Incidencias cerradas</h2><p>El historial conserva severidad, segmentos afectados, fecha de cierre y observación final de restauración.</p></div></div>
<div class="filter-panel"><div class="filter-grid" role="search"><div class="filter-field"><label for="ol-control-0">Filtrar por código</label><input placeholder="Ej. INC-004" type="search" id="ol-control-0"></div><div class="filter-field"><label for="ol-control-1">Filtrar por severidad</label><select id="ol-control-1"><option selected="">Todas</option><option>Crítica</option><option>Alta</option><option>Media</option><option>Baja</option></select></div><div class="filter-field"><label for="ol-control-2">Fecha desde</label><input type="date"  id="ol-control-2"></div><div class="filter-field"><label for="ol-control-3">Fecha hasta</label><input type="date"  id="ol-control-3"></div><div class="filter-actions"><button class="primary-button filter-submit" type="button"><i class="fa-solid fa-filter"></i> Filtrar</button></div></div></div>
<div class="table-container"><table data-page-size="10" data-client-page><thead><tr><th>Código</th><th>Segmentos</th><th>Severidad</th><th>Cierre</th><th>Observación</th><th class="action-cell">Acción</th></tr></thead><tbody><c:forEach var="fila" items="${filas}"><tr><c:forEach var="celda" items="${fila}"><td><c:choose><c:when test="${fn:startsWith(celda,'LINK:')}"><a class="icon-action" title="Ver detalle" aria-label="Ver detalle" href="${fn:substringAfter(celda,'LINK:')}"><i class="fa-regular fa-eye" aria-hidden="true"></i></a></c:when><c:otherwise><c:out value="${etiquetas[celda] != null ? etiquetas[celda] : celda}"/></c:otherwise></c:choose></td></c:forEach></tr></c:forEach></tbody></table></div></article>
<%@ include file="pie.jspf" %>
